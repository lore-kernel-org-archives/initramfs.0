+
+# run a command on remove events
+ACTION=="remove", ENV{REMOVE_CMD}!="", RUN+="$env{REMOVE_CMD}"
+
+# event to be catched by udevmonitor
+RUN+="socket:@/org/kernel/udev/monitor"
+
